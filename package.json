{
  "name": "semantic-instruments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Five browser-native instruments for inspecting the mathematics of semantic classification.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8773",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8773",
    "test": "tsx --test tests/*.test.ts",
    "postinstall": "node scripts/copy-runtime.mjs",
    "capture": "node scripts/capture-scenes.mjs",
    "verify:api": "node scripts/qa-scene-api.mjs",
    "build:site": "npm run build && node scripts/refresh-site.mjs",
    "verify:interventions": "node scripts/qa-scene-interventions.mjs",
    "verify:ui": "node scripts/qa-scene-ui.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "d3": "^7.9.0",
    "driver.js": "1.8.0",
    "fflate": "^0.8.2",
    "hyparquet": "^1.17.0",
    "hyparquet-compressors": "^1.1.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
