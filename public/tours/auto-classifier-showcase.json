{
  "schemaVersion": 1,
  "id": "auto-classifier-showcase",
  "version": 1,
  "title": "Auto-classifier · better learning with fewer labels",
  "description": "How auto-classifier turns domain knowledge into task-specific evidence. Each step opens its own scene on the paired weapons videos; choose Play automatically to run it hands-free.",
  "datasetIds": [
    "weapons-paired"
  ],
  "chapters": [
    {
      "id": "low-label",
      "title": "Make scarce labels useful",
      "description": "Why encoding task knowledge as semantic measurements lets scarce labels teach the boundary."
    },
    {
      "id": "prediction",
      "title": "Learn and combine evidence",
      "description": "How the trained head combines semantic evidence, and what text adds to the image."
    },
    {
      "id": "entity",
      "title": "Build the entity-level decision",
      "description": "From video scores to channel-level decisions, supported counts and reviewer dossiers."
    },
    {
      "id": "validation",
      "title": "Validate and close the loop",
      "description": "Checking the operating decision with designed samples, then summarizing the workflow."
    }
  ],
  "steps": [
